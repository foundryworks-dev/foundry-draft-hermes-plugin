# Example ~/.hermes/config.yaml fragment for the Foundry/Draft MCP server.
#
# Merge the `mcp_servers.draft` entry below into your existing
# ~/.hermes/config.yaml (scripts/install.sh does this for you when the
# file has no mcp_servers block yet). Replace the args path with the
# absolute path to this repo's mcp/draft-mcp.js.
#
# Hermes registers a stdio MCP server's tools as mcp_<server>_<tool>,
# so this `draft` server's tools appear as mcp_draft_queue,
# mcp_draft_context, mcp_draft_claim_story, and so on.

mcp_servers:
  draft:
    command: "node"
    args: ["/absolute/path/to/foundry-draft-hermes-plugin/mcp/draft-mcp.js"]

    # The env: block is REQUIRED. Unlike Claude Code / Codex, Hermes does
    # not hand a stdio MCP subprocess your shell environment — it forwards
    # only a safe baseline (PATH, HOME, USER, LANG, LC_ALL, TERM, SHELL,
    # TMPDIR, XDG_*) plus this map, and it does NOT interpolate ${VAR}
    # here. So `FOUNDRY_API_KEY=... hermes` never reaches the server; the
    # key has to be the literal value below. Keep this file out of version
    # control since it holds the secret.
    env:
      FOUNDRY_API_KEY: "fdrk_..."
      # FOUNDRY_API_URL is optional — only set it for a self-hosted Foundry.
      # Defaults to https://draft.foundryworks.dev when omitted.
      # FOUNDRY_API_URL: "https://draft.foundryworks.dev"
      #
      # An existing config using DRAFT_API_KEY / DRAFT_API_URL keeps working
      # and needs no edit — the server prefers FOUNDRY_* and falls back to
      # the DRAFT_* names, which are not going away (#456).
