# Example ~/.hermes/config.yaml fragment for the Foundry/Draft MCP server.
#
# Merge the `mcp_servers` entries below into your existing
# ~/.hermes/config.yaml (scripts/install.sh does this for you when the
# file has no mcp_servers block yet). Replace the args paths with the
# absolute path to this repo's mcp/draft-mcp.js.
#
# Hermes registers a stdio MCP server's tools as mcp_<server>_<tool>, and
# that prefix comes from the key you choose here — the server itself
# returns bare tool names. So exposing both namespaces means registering
# the same script twice under two keys (#457). `scripts/install.sh`
# writes both for you.
#
# The bundled skills call mcp_foundry_*, so the `foundry:` entry is the
# one they need. Register `draft:` as well if you have anything still
# calling mcp_draft_* — existing skills, cron jobs, your own prompts.
# It is not going away.

mcp_servers:
  foundry:
    command: "node"
    # --server-key must match the key above. Both entries run the same
    # script and the server returns bare tool names, so this flag is the
    # only way the process can tell which namespace it is serving — which
    # is what the `draft:` retirement gate measures (#458).
    args:
      [
        "/absolute/path/to/foundry-draft-hermes-plugin/mcp/draft-mcp.js",
        "--server-key=foundry",
      ]

    # The env: block is REQUIRED. Unlike Claude Code / Codex, Hermes does
    # not hand a stdio MCP subprocess your shell environment — it forwards
    # only a safe baseline (PATH, HOME, USER, LANG, LC_ALL, TERM, SHELL,
    # TMPDIR, XDG_*) plus this map, and it does NOT interpolate ${VAR}
    # here. So `FOUNDRY_API_KEY=... hermes` never reaches the server; the
    # key has to be the literal value below. Keep this file out of version
    # control since it holds the secret.
    env:
      FOUNDRY_API_KEY: "fdrk_..."
      # FOUNDRY_API_URL is optional — only set it for a self-hosted Foundry.
      # Defaults to https://app.foundryworks.dev when omitted.
      # FOUNDRY_API_URL: "https://app.foundryworks.dev"
      #
      # An existing config using DRAFT_API_KEY / DRAFT_API_URL keeps working
      # and needs no edit — the server prefers FOUNDRY_* and falls back to
      # the DRAFT_* names, which are not going away (#456).

  # Legacy namespace. Same script, same key, second mount — this is what
  # keeps mcp_draft_* resolving for anything written before the rename.
  draft:
    command: "node"
    args:
      [
        "/absolute/path/to/foundry-draft-hermes-plugin/mcp/draft-mcp.js",
        "--server-key=draft",
      ]
    env:
      FOUNDRY_API_KEY: "fdrk_..."
